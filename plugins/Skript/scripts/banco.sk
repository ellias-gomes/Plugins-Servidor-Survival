# ============================================================================
#  BANCO DE AURELION - depósitos, rendimentos diários, níveis, impostos e GUI
#  - Interação Orgânica: Shift + Clique Direito em um Baú do Fim (Ender Chest)
#    ou pelo Diário de Bordo abre o Cofre Real do Banco!
# ============================================================================

function limiteBanco(n: number) :: number:
    if {_n} is 1:
        return 20000
    if {_n} is 2:
        return 100000
    return 500000

function aplicarJurosBanco():
    loop {banco::*}:
        set {_u} to loop-index
        set {_dep} to loop-value
        if {_dep} > 0:
            set {_nivel} to {banconivel::%{_u}%}
            if {_nivel} is not set:
                set {_nivel} to 1
            set {_base} to min({_dep}, limiteBanco({_nivel}))
            set {_taxa} to {eco::juro} * {eco::evento::juro} * (1 + 0.25 * ({_nivel} - 1)) / 100
            set {_rend} to round({_base} * {_taxa})
            set {_ir} to round({_rend} * 0.1)
            set {_cust} to round({_dep} * 0.001)
            set {_liq} to {_rend} - {_ir} - {_cust}
            add {_ir} + {_cust} to {eco::tesouro}
            add {_liq} to {banco::%{_u}%}
            set {extrato::%{_u}%} to "&6[Banco] &7Rendimento do dia: &a+%{_rend}% &7| IR: &c-%{_ir}% &7| custódia: &c-%{_cust}% &7| líquido: &f%{_liq}%"
            loop all players:
                if "%uuid of loop-player%" is {_u}:
                    send {extrato::%{_u}%} to loop-player
                    delete {extrato::%{_u}%}

function depositarBanco(p: player, val: number):
    set {_u} to "%uuid of {_p}%"
    set {_nivel} to {banconivel::%{_u}%}
    if {_nivel} is not set:
        set {_nivel} to 1
    set {_dep} to {banco::%{_u}%}
    if {_dep} is not set:
        set {_dep} to 0
    set {_lim} to limiteBanco({_nivel})
    set {_val} to round({_val})
    if {_val} <= 0:
        send "&cVocê não tem saldo na carteira para depositar." to {_p}
        stop
    if {_p}'s balance < {_val}:
        send "&cSaldo insuficiente na carteira." to {_p}
        stop
    remove {_val} from {_p}'s balance
    add {_val} to {banco::%{_u}%}
    send "&a[Banco] Depositado: &f+%{_val}% Ouros" to {_p}
    if {_dep} + {_val} > {_lim}:
        send "&eAviso: o que passa de %{_lim}% não rende juros. Faça upgrade do seu banco!" to {_p}
    set {diario::%{_u}%::banco} to true
    play sound "block.ender_chest.open" to {_p}

function sacarBanco(p: player, val: number):
    set {_u} to "%uuid of {_p}%"
    set {_dep} to {banco::%{_u}%}
    if {_dep} is not set:
        set {_dep} to 0
    set {_val} to round({_val})
    if {_val} <= 0:
        send "&cVocê não possui saldo depositado no banco." to {_p}
        stop
    if {_dep} < {_val}:
        send "&cDepósito insuficiente no banco." to {_p}
        stop
    remove {_val} from {banco::%{_u}%}
    add {_val} to {_p}'s balance
    send "&a[Banco] Sacado para sua carteira: &f+%{_val}% Ouros" to {_p}
    play sound "entity.experience_orb.pickup" to {_p}

function upgradeBanco(p: player):
    set {_u} to "%uuid of {_p}%"
    set {_nivel} to {banconivel::%{_u}%}
    if {_nivel} is not set:
        set {_nivel} to 1
    if {_nivel} >= 3:
        send "&eSeu banco já está no nível máximo (Nível 3)." to {_p}
        stop
    if {_nivel} is 1:
        if {prog::boss::2} is not set:
            send "&cNível 2 exige que a Rainha das Marés (Thalassa) tenha sido purificada." to {_p}
            stop
        set {_custo} to precoServico(5000)
    else:
        if {prog::boss::4} is not set:
            send "&cNível 3 exige que o Oráculo Quebrado (Seraphel) tenha sido purificado." to {_p}
            stop
        set {_custo} to precoServico(25000)
    if {_p}'s balance < {_custo}:
        send "&cCusto do upgrade: %{_custo}% Ouros na carteira (saldo insuficiente)." to {_p}
        stop
    remove {_custo} from {_p}'s balance
    add {_custo} to {eco::tesouro}
    set {_novo} to {_nivel} + 1
    set {banconivel::%{_u}%} to {_novo}
    send "&6&l[Banco] Cofre melhorado para o Nível %{_novo}%! Limite e juros aumentaram!" to {_p}
    play sound "ui.toast.challenge_complete" to {_p}

function abrirMenuBanco(p: player):
    set {_u} to "%uuid of {_p}%"
    set {_nivel} to {banconivel::%{_u}%}
    if {_nivel} is not set:
        set {_nivel} to 1
    set {_dep} to {banco::%{_u}%}
    if {_dep} is not set:
        set {_dep} to 0
    set {_lim} to limiteBanco({_nivel})
    set {_juroHoje} to round({eco::juro} * {eco::evento::juro} * (1 + 0.25 * ({_nivel} - 1)) * 100) / 100
    set {_gui} to chest inventory with 3 rows named "&6&lBanco Real de Aurelion"
    set slot 4 of {_gui} to ender chest named "&6&lCofre Nível %{_nivel}%" with lore "&7Depositado no Banco: &a%round({_dep})% Ouros" and "&7Teto que rende juros: &f%{_lim}% Ouros" and "&7Saldo na Carteira: &e%round({_p}'s balance)% Ouros" and "&7Rendimento atual: &a%{_juroHoje}%%% ao dia"
    set slot 10 of {_gui} to gold ingot named "&a&lDepositar 500 Ouros" with lore "&7Transfere 500 Ouros da carteira para o Banco." and "&eClique para depositar"
    set slot 11 of {_gui} to gold block named "&a&lDepositar TUDO da Carteira" with lore "&7Guarda todo o seu saldo no Banco para render juros." and "&eClique para depositar tudo"
    set slot 12 of {_gui} to gold nugget named "&e&lSacar 500 Ouros" with lore "&7Retira 500 Ouros do Banco para a carteira." and "&eClique para sacar"
    set slot 13 of {_gui} to chest named "&e&lSacar TUDO do Banco" with lore "&7Transfere todo o depósito para sua carteira." and "&eClique para sacar tudo"
    set slot 15 of {_gui} to sunflower named "&6&lCunhar 100 Moedas Físicas" with lore "&7Saca 100 Ouros da carteira em um" and "&6Lingote Real de Aurelion &7físico!" and "&eClique para sacar moeda física"
    set slot 16 of {_gui} to nether star named "&b&lMelhorar Nível do Banco" with lore "&7Nível 2: exige vencer Thalassa (base 5.000)" and "&7Nível 3: exige vencer Seraphel (base 25.000)" and "&eClique para fazer upgrade"
    set slot 22 of {_gui} to arrow named "&7Voltar ao Diário de Bordo" with lore "&eClique para voltar"
    open {_gui} to {_p}

# Interação orgânica: Shift + Clique Direito em um Ender Chest abre o Banco de Aurelion!
on right click on ender chest:
    if player is sneaking:
        cancel event
        abrirMenuBanco(player)

on inventory click:
    if "%name of event-inventory%" contains "Banco Real de Aurelion":
        cancel event
        set {_idx} to index of clicked slot
        set {_u} to "%uuid of player%"
        if {_idx} is 10:
            depositarBanco(player, min(500, round(player's balance)))
            abrirMenuBanco(player)
        else if {_idx} is 11:
            depositarBanco(player, round(player's balance))
            abrirMenuBanco(player)
        else if {_idx} is 12:
            set {_dep} to {banco::%{_u}%}
            if {_dep} is not set:
                set {_dep} to 0
            sacarBanco(player, min(500, {_dep}))
            abrirMenuBanco(player)
        else if {_idx} is 13:
            set {_dep} to {banco::%{_u}%}
            if {_dep} is not set:
                set {_dep} to 0
            sacarBanco(player, {_dep})
            abrirMenuBanco(player)
        else if {_idx} is 15:
            execute player command "moeda sacar 100"
            abrirMenuBanco(player)
        else if {_idx} is 16:
            upgradeBanco(player)
            abrirMenuBanco(player)
        else if {_idx} is 22:
            close player's inventory
            execute player command "diario"

command /banco [<text>] [<number>]:
    aliases: /bank
    description: Banco de Aurelion
    trigger:
        if arg-1 is not set:
            abrirMenuBanco(player)
            stop
        if arg-1 is "depositar":
            if arg-2 is set:
                depositarBanco(player, arg-2)
            else:
                abrirMenuBanco(player)
        else if arg-1 is "sacar":
            if arg-2 is set:
                sacarBanco(player, arg-2)
            else:
                abrirMenuBanco(player)
        else if arg-1 is "upgrade":
            upgradeBanco(player)
        else:
            abrirMenuBanco(player)
