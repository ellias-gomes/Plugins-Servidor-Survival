# ============================================================================
#  LORE - "As Cinzas de Aurelion"
#  - Livro Físico Oficial: "Crônicas de Aurelion" (Shift+Clique abre o Menu do Eco de Valdric!)
#  - Pergaminhos de Memória Ancestral entregues após cada Guardião
#  - Escolha Orgânica do Desfecho: Clique Direito com o "Coração da Chama" abre o Altar do Destino!
# ============================================================================

function darLivroLore(p: player):
    execute console command "execute as %uuid of {_p}% run function aurelion:dar_livro_lore"

function pergaminhoMemoria(id: number) :: item:
    set {_nome} to "&6&lMemória Ancestral #%{_id}%"
    set {_l1} to "&7Fragmento da alma do guardião."
    set {_l2} to "&eClique com botão direito para escutar a voz do passado."
    if {_id} is 1:
        return 1 of paper named {_nome} with lore {_l1} and "&2Voz de Verdelith" and {_l2}
    else if {_id} is 2:
        return 1 of paper named {_nome} with lore {_l1} and "&bVoz de Thalassa" and {_l2}
    else if {_id} is 3:
        return 1 of paper named {_nome} with lore {_l1} and "&cVoz de Korvan" and {_l2}
    else if {_id} is 4:
        return 1 of paper named {_nome} with lore {_l1} and "&dVoz de Seraphel" and {_l2}
    return 1 of paper named {_nome} with lore {_l1} and "&5Voz do Eclipse" and {_l2}

function lembranca(id: number) :: text:
    if {_id} is 1:
        return "&2[Verdelith] &7'Eu vi quando a torre ruiu. O Cartógrafo gritava: Não toque na Chama! Ela vai nos devorar! Mas o Estrategista estava de joelhos, tentando salvar o velho mestre... Nenhum dos dois estava errado. Por que lutaram?'"
    if {_id} is 2:
        return "&b[Thalassa] &7'As ondas engoliram o cais naquele dia. O Cartógrafo implorava: Deixe o mestre descansar em paz, irmão! E o Estrategista respondia: Ele nos deu tudo! Não vou virar as costas agora! Foi a última vez que se olharam nos olhos.'"
    if {_id} is 3:
        return "&c[Korvan] &7'Eu forjei duas lâminas sagradas para os irmãos. Mas na hora da fúria, o ouro se manchou com o sangue fraterno. Vocês sentem a cicatriz na palma da mão? Ela ainda queima com a dor daquela noite.'"
    if {_id} is 4:
        return "&d[Seraphel] &7'Eu avisei às estrelas: Um de vós abandonará o outro no abismo, e esse abandono ganhará corpo e sombra. Vós me chamastes de louco... mas a sombra nasceu e se chama Eclipse.'"
    return "&5[O Eclipse] &7'Eu sou a vossa dor encarnada. A culpa do Pedro por ter duvidado. O rancor do Ellias por ter sido atacado. Enquanto não perdoardes um ao outro, eu serei eterno!'"

function registrarMemoria(p: player, id: number):
    set {memoria::%uuid of {_p}%::%{_id}%} to true
    give pergaminhoMemoria({_id}) to {_p}
    send "" to {_p}
    send "&6&l✦ MEMÓRIA ANCESTRAL RECUPERADA ✦" to {_p}
    send lembranca({_id}) to {_p}
    send "&7(Um pergaminho foi colocado em seu inventário. Clique nele com o botão direito para reler!)" to {_p}
    play sound "block.enchantment_table.use" to {_p}

on right click with paper:
    if "%name of player's tool%" contains "Memória Ancestral":
        cancel event
        loop 5 times:
            if "%name of player's tool%" contains "#%loop-number%":
                send "" to player
                send "&6&l=== MEMÓRIA DO PASSADO #%loop-number% ===" to player
                send lembranca(loop-number) to player
                play sound "item.book.page_turn" to player
                stop

# ---------- Interação Orgânica com o Livro Crônicas de Aurelion (Shift + Clique Direito) ----------

function consultarMentor(p: player):
    set {diario::%uuid of {_p}%::mentor} to true
    set {_o} to proximoObjetivo({_p})
    send "" to {_p}
    send "&6[Eco de Valdric] &7A marca de ouro em sua mão aquece e você escuta a voz de seu mestre:" to {_p}
    if {_o} is 0:
        send "&a'Meus filhos... vós superastes a escuridão. Segurem o Coração da Chama e cliquem com o botão direito para selar o destino do mundo!'" to {_p}
    else:
        send "&e'Vossa próxima provação: &f%tituloObj({_o})%&e.'" to {_p}
        send "&7%descObj({_o})%" to {_p}
    play sound "block.beacon.ambient" to {_p}

function abrirMenuLore(p: player):
    set {_gui} to chest inventory with 3 rows named "&6&lSantuário de Lore & Valdric"
    set slot 11 of {_gui} to beacon named "&6&lOuvir o Eco de Valdric (Mentor)" with lore "&7Sintonize a marca de ouro na sua palma" and "&7para ouvir o conselho do Alquimista-Rei." and "&eClique para escutar!"
    set slot 13 of {_gui} to paper named "&e&lMemórias dos Guardiões" with lore "&7Releia as lembranças recuperadas" and "&7ao purificar os Guardiões de Aurelion." and "&eClique para recordar!"
    set slot 15 of {_gui} to writable book named "&a&lAbrir Diário de Bordo" with lore "&7Acompanhe os 10 Objetivos da Campanha," and "&7Pets, Banco e Caçadas." and "&eClique para abrir!"
    open {_gui} to {_p}

on right click with written book:
    if player is sneaking:
        cancel event
        abrirMenuLore(player)

on inventory click:
    if "%name of event-inventory%" contains "Santuário de Lore & Valdric":
        cancel event
        set {_idx} to index of clicked slot
        if {_idx} is 11:
            close player's inventory
            consultarMentor(player)
        else if {_idx} is 13:
            close player's inventory
            execute player command "memorias"
        else if {_idx} is 15:
            close player's inventory
            execute player command "diario"

# ---------- Escolha Orgânica do Desfecho com a Relíquia "Coração da Chama" ----------

function abrirMenuFinal(p: player):
    if {prog::boss::5} is not set:
        send "&cO Eclipse ainda não foi derrotado nas profundezas!" to {_p}
        stop
    if {final::resolvido} is set:
        send "&7O destino de Aurelion já foi selado: &f%{final::resolvido}%" to {_p}
        stop
    set {_gui} to chest inventory with 3 rows named "&6&lO Destino da Chama-Coração"
    set slot 11 of {_gui} to beacon named "&6&l1. RESTAURAR A CHAMA" with lore "&7Reerguer o Império de Aurelion." and "&7Ellias e Pedro são coroados os" and "&7Novos Imperadores da Ordem." and "&e• Fronteira +10.000 blocos & Prosperidade" and "" and "&6Clique para votar em RESTAURAR!"
    set slot 15 of {_gui} to ender eye named "&5&l2. LIBERTAR O MUNDO" with lore "&7Despedaçar o cristal no Vazio." and "&7Romper o ciclo de reis e tronos," and "&7devolvendo a magia livre à natureza." and "&d• Fronteira +10.000 blocos & Liberdade" and "" and "&5Clique para votar em LIBERTAR!"
    open {_gui} to {_p}

function votarFinal(p: player, escolha: text):
    if {prog::boss::5} is not set:
        send "&cO Eclipse ainda não foi derrotado nas profundezas." to {_p}
        stop
    if {final::resolvido} is set:
        send "&7O destino de Aurelion já foi selado: &f%{final::resolvido}%" to {_p}
        stop
    set {final::%uuid of {_p}%} to {_escolha}
    broadcast "&6[Aurelion] &e%{_p}% &7tocou o Coração da Chama e escolheu: &f%{_escolha}%. &7Aguardando a decisão em consenso..."
    play sound "block.end_portal_frame.fill" to {_p}
    set {_acordo} to true
    set {_conta} to 0
    loop all players:
        add 1 to {_conta}
        if {final::%uuid of loop-player%} is not {_escolha}:
            set {_acordo} to false
    if {_conta} < 2:
        set {_acordo} to false
    if {_acordo} is true:
        set {final::resolvido} to {_escolha}
        add 1 to {temporada}
        execute console command "worldborder add 10000 180"
        if {_escolha} is "restaurar":
            broadcast ""
            broadcast "&6&l✦ A CHAMA-CORAÇÃO RENASCE PURIFICADA ✦"
            broadcast "&eO Império de Aurelion ergue-se das cinzas! Ellias e Pedro são coroados os Reis da Nova Ordem."
            broadcast "&7A fronteira do mundo expandiu em +10.000 blocos e a prosperidade brilha eternamente."
            broadcast ""
        else:
            broadcast ""
            broadcast "&5&l✦ O MUNDO É LIVRE DO JUGO DA CHAMA ✦"
            broadcast "&dO cristal foi despedaçado! Ninguém mais será escravo da ambição de governar."
            broadcast "&7A fronteira do mundo expandiu em +10.000 blocos para vocês explorarem como homens livres."
            broadcast ""
        loop all players:
            give loop-player 1 beacon named "&6&lSelo da Nova Era"
            add 100 to {runas::%uuid of loop-player%}
            play sound "ui.toast.challenge_complete" to loop-player

on right click with nether star:
    if "%name of player's tool%" contains "Coração da Chama":
        cancel event
        abrirMenuFinal(player)

on inventory click:
    if "%name of event-inventory%" contains "O Destino da Chama-Coração":
        cancel event
        set {_idx} to index of clicked slot
        if {_idx} is 11:
            close player's inventory
            votarFinal(player, "restaurar")
        else if {_idx} is 15:
            close player's inventory
            votarFinal(player, "libertar")

on first join:
    set {_u} to "%uuid of player%"
    give player 16 bread
    give player 24 torch
    give player a compass
    give player a stone pickaxe
    give player a stone axe
    wait 2 seconds
    darLivroLore(player)
    send title "&6&lCinzas de Aurelion" with subtitle "&7Você acorda marcado pelo Fio Dourado..." to player for 6 seconds
    wait 4 seconds
    send "&6&l=== AS CINZAS DE AURELION ===" to player
    send "&7Você e seu parceiro acordaram marcados pelo &6Fio de Ouro&7." to player
    send "&e• Livro Crônicas de Aurelion: &7Abra para ler ou faça &fShift + Clique Direito &7com ele para falar com o Mentor Valdric!" to player
    send "&e• Bússola Rúnica: &7Clique com o botão direito segurando a &fBússola &7para rastrear os Guardiões e ver os Rituais!" to player

command /lore [<text>]:
    aliases: /historia, /cronicas
    description: A história sagrada de Aurelion
    trigger:
        if arg-1 is "livro":
            darLivroLore(player)
            send "&aVocê recebeu um novo exemplar das &6Crônicas de Aurelion&a!" to player
            play sound "item.book.put" to player
            stop
        abrirMenuLore(player)

command /memorias:
    aliases: /lembrancas
    trigger:
        set {_n} to 0
        send "&6&l=== Memórias Desbloqueadas dos Guardiões ===" to player
        loop 5 times:
            if {memoria::%uuid of player%::%loop-number%} is set:
                add 1 to {_n}
                send "" to player
                send lembranca(loop-number) to player
        if {_n} is 0:
            send "&7Nenhuma memória recuperada ainda. Desbrave os Santuários e vença os Guardiões." to player

command /mentor:
    aliases: /guia
    description: Conselho do Alquimista-Rei Valdric
    trigger:
        consultarMentor(player)

command /final [<text>]:
    description: Escolha o destino da Chama-Coração (restaurar | libertar)
    trigger:
        if arg-1 is "restaurar":
            votarFinal(player, "restaurar")
        else if arg-1 is "libertar":
            votarFinal(player, "libertar")
        else:
            abrirMenuFinal(player)
